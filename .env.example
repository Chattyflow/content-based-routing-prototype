# Optional: real AI for the prototype (local dev server only).
#  - an AI check next to the rules, and
#  - real chat answers instead of the canned demo replies.
# Copy this file to .env and add your OpenRouter key. Without a key the app
# uses its rules and canned replies. Use test data: messages go to the model.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# One or more models, comma-separated; if one is busy or fails, the next is tried.
# Free models (":free") share rate limits with everyone and change often:
# see https://openrouter.ai/models for what is available.
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free,poolside/laguna-s-2.1:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free
