# Optional: real AI for the prototype (here for local use; on Netlify, set the
# same names under Environment variables).
#  - an AI check next to the rules, and
#  - real chat answers instead of the canned demo replies.
# Copy this file to .env and add your OpenRouter key. Without a key the app
# uses its rules and canned replies. Use test data: messages go to the model.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Optional: your own model list, comma-separated; if one is busy or fails, the
# next is tried. Leave it unset to use the built-in list of tested free models
# (DEFAULT_MODELS in server/api.ts). Free models change often:
# https://openrouter.ai/models?q=free
# LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free,poolside/laguna-s-2.1:free

# Optional backup providers, tried in this order when OpenRouter's free
# allowance is used up. Each switches on when its key is set. Each has its own
# free tier and limits; check the provider's site. Model names can be replaced
# with a comma-separated *_MODEL variable.
# GROQ_API_KEY=            # https://console.groq.com/keys
# CEREBRAS_API_KEY=        # https://cloud.cerebras.ai
# GOOGLE_AI_STUDIO_KEY=    # https://aistudio.google.com/apikey (not GEMINI_API_KEY: Netlify's AI Gateway uses that name)
# MISTRAL_API_KEY=         # https://console.mistral.ai
# Any other OpenAI-compatible provider:
# BACKUP_NAME=
# BACKUP_BASE_URL=
# BACKUP_API_KEY=
# BACKUP_MODEL=
